provider:
  name: rfc2136
txtPrefix: {{ external_dns_namespace }}-
txtOwnerId: {{ external_dns_txt_owner_id }}
domainFilters:
  - istio.{{ dns_domain_suffix }}
sources:
  - service
  - ingress
  - istio-gateway
  - istio-virtualservice
extraArgs:
  - --rfc2136-host={{ dns_server_ip }}
  - --rfc2136-port=53
  - --rfc2136-zone=istio.{{ dns_domain_suffix }}
  - --rfc2136-tsig-secret={{ k8s_secrets.external_dns_istio_tsig_secret }}
  - --rfc2136-tsig-secret-alg=hmac-sha256
  - --rfc2136-tsig-keyname=istio.{{ dns_domain_suffix }}-key
  - --rfc2136-tsig-axfr
