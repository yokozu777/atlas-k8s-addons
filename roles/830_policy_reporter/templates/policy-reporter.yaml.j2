# HTTPRoute + Envoy OIDC for {{ policy_reporter_host }} is created by 961_apply_oidc_ingress (560 skips oidc_auth).
# Chart auto-wires UI → core + kyverno plugin via default-cluster secret.
# Sidecar label grafana_dashboard=1; kube-prometheus Grafana searches all namespaces.
metrics:
  enabled: true
monitoring:
  enabled: true
  serviceMonitor:
    enabled: true
grafana:
  dashboards:
    enabled: true
    label: grafana_dashboard
    value: "1"
ui:
  enabled: true
  ingress:
    enabled: false
  httproute:
    enabled: false
plugin:
  kyverno:
    enabled: true
    ingress:
      enabled: false
    httproute:
      enabled: false
