      # ({{ calico_chart_version }}), extracted at 310_prometheus apply.
      # Origin follows grafana_dashboard_source.calico_typha (github|infra).
      # Do not import felix-dashboard.json from that ConfigMap (same uid as gnet 12175).
{% endif %}
