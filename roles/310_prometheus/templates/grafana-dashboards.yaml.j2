# Grafana dashboards for kube-prometheus-stack grafana.dashboards.cluster-addons.
# Helm downloads url/gnetId at 310_prometheus apply (controller needs egress).
# Gate on *_chart_state so absent charts do not provision empty dashboards.
# List-form datasource: Helm sed replaces ${DS_PROMETHEUS}/${DS_PROMXY}/${datasource}
# /${DS_SIGNCL-PROMETHEUS} with Grafana DS uid (prometheus), not the display name.
# Does not slice JSON objects. Thanos stays a second DS; panels use Prometheus.
# url origin: grafana_raw_prefix(entity) — github (raw.githubusercontent.com) or infra.
# grafana-native: grafana_gnet — gnetId (grafana.com) or url via grafana_dashboard_infra_base.
{% macro grafana_prometheus_ds() %}
        datasource:
          - name: DS_PROMETHEUS
            value: prometheus
          - name: DS_PROMXY
            value: prometheus
          - name: datasource
            value: prometheus
          - name: DS_SIGNCL-PROMETHEUS
            value: prometheus
{% endmacro %}
{% macro grafana_raw_prefix(entity) -%}
{%- set src = (grafana_dashboard_source | default({}))[entity] | default('github') -%}
{%- if src == 'infra' -%}
{{ grafana_dashboard_infra_base | default('') | regex_replace('/+$', '') }}
{%- else -%}
https://raw.githubusercontent.com
{%- endif -%}
{%- endmacro %}
{% macro grafana_gnet(entity, gnet_id, revision, emit_revision=true) -%}
{%- set src = (grafana_dashboard_source | default({}))[entity] | default('grafana') -%}
{%- if src == 'infra' %}
        url: {{ grafana_dashboard_infra_base | default('') | regex_replace('/+$', '') }}/api/dashboards/{{ gnet_id }}/revisions/{{ revision }}/download
{%- else %}
        gnetId: {{ gnet_id }}
{%- if emit_revision %}
        revision: {{ revision }}
{%- endif %}
{%- endif %}
{%- endmacro %}
{% if calico_chart_state | default('present') == 'present' %}
