prometheus:
  url: http://prometheus-kube-prometheus-prometheus.{{ monitoring_namespace }}.svc.{{ k8s_dns_domain }}
  port: 9090
  path: ""

rules:
  default: false
  resource:
    # HPA resource metrics must ignore pause/pod cgroup (empty or POD container).
    cpu:
      containerQuery: >-
        sum(rate(container_cpu_usage_seconds_total{container!="",container!="POD",<<.LabelMatchers>>}[3m])) by (<<.GroupBy>>)
      nodeQuery: >-
        sum(rate(container_cpu_usage_seconds_total{container!="",container!="POD",<<.LabelMatchers>>}[3m])) by (<<.GroupBy>>)
      resources:
        overrides:
          node:
            resource: node
          namespace:
            resource: namespace
          pod:
            resource: pod
      containerLabel: container
    memory:
      containerQuery: >-
        sum(container_memory_working_set_bytes{container!="",container!="POD",<<.LabelMatchers>>}) by (<<.GroupBy>>)
      nodeQuery: >-
        sum(container_memory_working_set_bytes{container!="",container!="POD",<<.LabelMatchers>>}) by (<<.GroupBy>>)
      resources:
        overrides:
          node:
            resource: node
          namespace:
            resource: namespace
          pod:
            resource: pod
      containerLabel: container
    window: 3m

hostNetwork:
  enabled: false
