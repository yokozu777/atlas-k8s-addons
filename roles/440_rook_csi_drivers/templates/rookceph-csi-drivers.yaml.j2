# Rook-compatible default values for the ceph-csi-drivers Helm chart.
#
# Use these values when installing or upgrading the ceph-csi-drivers chart
# alongside the {{ rook_operator_namespace }} operator chart. The driver names must match the
# provisioner names used by Rook (e.g. in StorageClasses and VolumeSnapshotClasses).
#
# If the Rook operator is installed in a namespace other than {{ rook_operator_namespace }}, replace
# "{{ rook_operator_namespace }}" in the driver names below with your operator namespace.

operatorConfig:
  namespace: {{ rook_operator_namespace }} # namespace:operator
  driverSpecDefaults:
    imageSet:
      name: rook-csi-operator-image-set-configmap
    nodePlugin:
      priorityClassName: system-node-critical
    controllerPlugin:
      priorityClassName: system-cluster-critical

drivers:
  rbd:
    enabled: true
    name: {{ rook_operator_namespace }}.rbd.csi.ceph.com # csi-provisioner-name
  cephfs:
    enabled: true
    name: {{ rook_operator_namespace }}.cephfs.csi.ceph.com # csi-provisioner-name
  nfs:
    enabled: false
    name: {{ rook_operator_namespace }}.nfs.csi.ceph.com # csi-provisioner-name
  nvmeof:
    enabled: false
    name: {{ rook_operator_namespace }}.nvmeof.csi.ceph.com # csi-provisioner-name