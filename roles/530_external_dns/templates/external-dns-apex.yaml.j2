provider:
  name: rfc2136
txtPrefix: {{ external_dns_namespace }}-apex-
txtOwnerId: {{ external_dns_apex_txt_owner_id }}
domainFilters:
  - {{ dns_domain_suffix }}
excludeDomains:
  - {{ k8s_cluster_domain }}
  - istio.{{ dns_domain_suffix }}
sources:
  - crd
extraArgs:
  - --rfc2136-host={{ dns_server_ip }}
  - --rfc2136-port=53
  - --rfc2136-zone={{ dns_domain_suffix }}
  - --rfc2136-tsig-secret={{ k8s_secrets.external_dns_apex_tsig_secret }}
  - --rfc2136-tsig-secret-alg=hmac-sha256
  - --rfc2136-tsig-keyname={{ dns_domain_suffix }}
  - --rfc2136-tsig-axfr
  - --managed-record-types=A
  - --managed-record-types=AAAA
  - --managed-record-types=CNAME
  - --managed-record-types=MX
  - --managed-record-types=TXT
