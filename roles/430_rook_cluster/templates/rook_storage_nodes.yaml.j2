# Generated by role 430_rook_cluster
# Source of truth: {{ provision_hosts_file }}
#####################################################
cephClusterSpec:
  storage:
    useAllNodes: false
    useAllDevices: false
    config:
      databaseSizeMB: "{{ provision_rook_database_size_mb }}"
    nodes:
{% for ip, host in cluster_hosts.all.children[k8s_worker_hosts | default('k8s_workers')].hosts.items() %}
{% set data_disk = host.provision.disks[provision_rook_data_disk_index] %}
{% if data_disk.wwn is defined %}
      - name: {{ host.hostname }}
        devices:
          - name: "{{ provision_rook_wwn_path_prefix }}{{ data_disk.wwn }}"
{% endif %}
{% endfor %}
#####################################################
