# Installs a debugging toolbox deployment
toolbox:
  enabled: true
  containerSecurityContext:
    runAsNonRoot: true  
  
  ##image: quay.io/ceph/ceph:v17.2.6

monitoring:
  # -- Enable monitoring. Requires Prometheus to be pre-installed.
  # Enabling will also create RBAC rules to allow Operator to create ServiceMonitors
  enabled: true
  rulesNamespaceOverride: {{ monitoring_namespace }}
  createPrometheusRules: true
  prometheusRule:
    # -- Labels applied to PrometheusRule
    labels: {}
    # -- Annotations applied to PrometheusRule
    annotations: {}

cephClusterSpec:
  # Warn threshold only (Ceph default 250). Does not change pg_num or CRUSH.
  # Empty rook_mon_max_pg_per_osd omits this and keeps Ceph default.
{% if rook_mon_max_pg_per_osd | default('') | string | trim | length > 0 %}
  cephConfig:
    global:
      mon_max_pg_per_osd: "{{ rook_mon_max_pg_per_osd }}"
{% endif %}
  placement:
    all:
      nodeAffinity:
        requiredDuringSchedulingIgnoredDuringExecution:
          nodeSelectorTerms:
            - matchExpressions:
                - key: loadtype
                  operator: In
                  values:
                    - worker

  resources:
    prepareosd:
      limits:
        memory: 0
        
  # cephVersion:
  #   ##image: quay.io/ceph/ceph:v17.2.6
  #   allowUnsupported: false

  dataDirHostPath: /var/lib/rook

  skipUpgradeChecks: true

  # Whether or not continue if PGs are not clean during an upgrade
  continueUpgradeAfterChecksEvenIfNotHealthy: false

  # WaitTimeoutForHealthyOSDInMinutes defines the time (in minutes) the operator would wait before an OSD can be stopped for upgrade or restart.
  # If the timeout exceeds and OSD is not ok to stop, then the operator would skip upgrade for the current OSD and proceed with the next one
  # if `continueUpgradeAfterChecksEvenIfNotHealthy` is `false`. If `continueUpgradeAfterChecksEvenIfNotHealthy` is `true`, then operator would
  # continue with the upgrade of an OSD even if its not ok to stop after the timeout. This timeout won't be applied if `skipUpgradeChecks` is `true`.
  # The default wait timeout is 10 minutes.
  waitTimeoutForHealthyOSDInMinutes: 1

  mon:
    count: 3
    allowMultiplePerNode: true

  mgr:
    count: 2
    allowMultiplePerNode: false
    modules:
      - name: pg_autoscaler
        enabled: true
      - name: mds_autoscaler
        enabled: false
      - name: cephadm
        enabled: false
      - name: rgw
        enabled: true
      - name: osd_support
        enabled: true
      - name: rook
        enabled: true
      - name: stats
        enabled: false
      - name: insights
        enabled: true  
      - name: diskprediction_local
        enabled: true
      - name: k8sevents
        enabled: true
      - name: alerts
        enabled: true
      - name: mirroring
        enabled: true
      - name: osd_perf_query
        enabled: true  
      - name: selftest
        enabled: true
      - name: telemetry
        enabled: false
      - name: snap_schedule
        enabled: true            

  # enable the ceph dashboard for viewing cluster status
  dashboard:
    enabled: true
    prometheusEndpoint: http://prometheus-kube-prometheus-prometheus.{{ monitoring_namespace }}.svc.{{ k8s_dns_domain }}:9090
    # serve the dashboard under a subpath (useful when you are accessing the dashboard via a reverse proxy)
    # urlPrefix: /ceph-dashboard
    # serve the dashboard at the given port.
    #port: 443
    # Serve the dashboard using SSL (if using ingress to expose the dashboard and `ssl: true` you need to set
    # the corresponding "backend protocol" annotation(s) for your ingress controller of choice)
    ssl: false

  # network:
  #   provider: host

  # enable the crash collector for ceph daemon crash collection
  crashCollector:
    disable: true
    # Uncomment daysToRetain to prune ceph crash entries older than the
    # specified number of days.
    daysToRetain: 30

  # enable log collector, daemons will log on files and rotate
  logCollector:
    enabled: true
    periodicity: daily # one of: hourly, daily, weekly, monthly
    maxLogSize: 500M # SUFFIX may be 'M' or 'G'. Must be at least 1M.

  # storage: # cluster level storage configuration and selection
  #   useAllNodes: false
  #   useAllDevices: false
  #   config:
  #     metadataDevice:
  #     databaseSizeMB: "1024"

  #   nodes:
  #   - name: "kubeworker01.{{ dns_domain_suffix }}"
  #     devices:
  #       - name: "/dev/disk/by-id/wwn-*"

  #   - name: "kubeworker02.{{ dns_domain_suffix }}"
  #     devices:
  #       - name: "/dev/disk/by-id/wwn-*"
        
  #   - name: "kubeworker03.{{ dns_domain_suffix }}"
  #     devices:
  #       - name: "/dev/disk/by-id/wwn-*"

    # nodes:
    # - name: "kubeworker01.{{ dns_domain_suffix }}"
    #   devices:
    #     - name: "/dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_drive225"

    # - name: "kubeworker02.{{ dns_domain_suffix }}"
    #   devices:
    #     - name: "/dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_drive226"
        
    # - name: "kubeworker03.{{ dns_domain_suffix }}"
    #   devices:
    #     - name: "/dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_drive227"


  resources:
    mgr:
      limits:
        memory: 0
      requests:
        cpu: 0
        memory: 0
    mon:
      limits:
        memory: 0
      requests:
        cpu: 0
        memory: 0
    osd:
      limits:
        memory: 0
      requests:
        cpu: 0
        memory: 0 

