relay:
  resources:
   limits:
     cpu: 100m
     memory: 200Mi
   requests:
     cpu: 10m
     memory: 32Mi
  replicas: 1
  autoscaling:
    enabled: true
    minReplicas: 2
    maxReplicas: 5
    targetCPUUtilizationPercentage: 50
