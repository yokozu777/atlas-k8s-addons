mail:
  backend: {{ sentry_mail.backend }}
  useTls: {{ 'true' if sentry_mail.use_tls else 'false' }}
  username: "{{ sentry_mail.username }}"
  password: "{{ k8s_secrets.sentry_smtp_password }}"
  port: {{ sentry_mail.port }}
  host: "{{ sentry_mail.host }}"
  from: "{{ sentry_mail.from }}"

user:
  create: true
  email: {{ sentry_admin_email }}
  password: "{{ k8s_secrets.sentry_admin_password }}"
hooks:
  enabled: true
  removeOnSuccess: true
  activeDeadlineSeconds: 2500
  shareProcessNamespace: false
  dbCheck:
    resources:
      limits:
        memory: 0
      requests:
        cpu: 0
        memory: 0
  dbInit:
    resources:
      limits:
        memory: 0
      requests:
        cpu: 0
        memory: 0
  snubaInit:
    resources:
      limits:
        cpu: 0
        memory: 0
      requests:
        cpu: 0
        memory: 0
rabbitmq:
  ulimitNofiles: ""
metrics:
  enabled: true
  serviceMonitor:
    enabled: true
