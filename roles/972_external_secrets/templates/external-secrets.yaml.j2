serviceMonitor:
  enabled: true

metrics:
  service:
    enabled: true

# Chart default vanity registry is not mirrored; pin to GHCR (pull-through already exists).
image:
  repository: ghcr.io/external-secrets/external-secrets

webhook:
  image:
    repository: ghcr.io/external-secrets/external-secrets
  metrics:
    service:
      enabled: true

certController:
  image:
    repository: ghcr.io/external-secrets/external-secrets
  metrics:
    service:
      enabled: true
