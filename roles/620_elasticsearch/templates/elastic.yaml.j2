replicas: 1
minimumMasterNodes: 1
image: "elastic/elasticsearch"
imageTag: "{{ ESimageTag }}"
protocol: https
httpPort: 9200
transportPort: 9300
createCert: false

roles:
  - master
  - data
  - data_content
  - ingest
  - transform

esJavaOpts: "-Xms1024m -Xmx1024m"

resources:
  requests:
    cpu: "0"
  limits:
    cpu: "0"

secret:
  enabled: false

extraEnvs:
  - name: "ELASTIC_PASSWORD"
    valueFrom:
      secretKeyRef:
        name: "elastic-credentials"
        key: "password"
  - name: "ELASTIC_USERNAME"
    valueFrom:
      secretKeyRef:
        name: "elastic-credentials"
        key: "username"

secretMounts:
  - name: elastic-certificates
    secretName: elastic-certificates
    path: /usr/share/elasticsearch/config/certs

service:
  labels: {}
  labelsHeadless: {}
  type: ClusterIP
  nodePort: ""
  annotations: {}
  httpPortName: https
  transportPortName: transport
  loadBalancerIP: ""
  loadBalancerSourceRanges: []
  externalTrafficPolicy: ""

volumeClaimTemplate:
  storageClassName: ceph-block
  accessModes:
  - ReadWriteOnce
  resources:
    requests:
      storage: 5Gi

keystore:
  - secretName: elastic-certificates-password
{% if elasticsearch_s3_ready | default(false) | bool %}
  - secretName: "{{ elasticsearch_s3_credentials_secret }}"
{% endif %}

esConfig:
  elasticsearch.yml: |
    xpack.monitoring.collection.enabled: "false"
    xpack.ml.enabled: "false"
    xpack.license.self_generated.type: basic
    xpack.security.enabled: "true"
    xpack.security.autoconfiguration.enabled: "false"
    xpack.security.transport.ssl.enabled: "true"
    xpack.security.transport.ssl.keystore.path: /usr/share/elasticsearch/config/certs/elastic.p12
    xpack.security.transport.ssl.truststore.path: /usr/share/elasticsearch/config/certs/elastic_ca.p12
    xpack.security.transport.ssl.verification_mode: "certificate"
    xpack.security.http.ssl.enabled: "true"
    xpack.security.http.ssl.truststore.path: /usr/share/elasticsearch/config/certs/elastic_ca.p12
    xpack.security.http.ssl.keystore.path: /usr/share/elasticsearch/config/certs/elastic.p12
    xpack.security.authc.realms.native.local.order: "0"
{% if elasticsearch_s3_ready | default(false) | bool %}
    s3.client.default.endpoint: "{{ elasticsearch_s3_client_endpoint }}"
    s3.client.default.protocol: "{{ elasticsearch_s3_client_protocol }}"
    s3.client.default.path_style_access: true
    s3.client.default.region: "{{ elasticsearch_s3_region | default('us-east-1') }}"
{% endif %}
