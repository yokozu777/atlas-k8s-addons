# Cluster credentials export — generated by Ansible role 996_cluster_report
# Do not commit this file to git.
{% set report = cluster_credentials_report %}
{% set mode = report.meta.mode | default('full') %}

meta:
{{ report.meta | to_nice_yaml | indent(2, first=True) }}

access:
{{ report.access | to_nice_yaml | indent(2, first=True) }}

paths:
{{ report.paths | to_nice_yaml | indent(2, first=True) }}

endpoints:
{{ report.endpoints | to_nice_yaml | indent(2, first=True) }}

quick_access:
{{ report.quick_access | default([]) | to_nice_yaml | indent(2, first=True) }}

services:
{% for svc in report.services | default([]) %}
  - id: {{ svc.id }}
    section: {{ svc.section }}
    title: {{ svc.title }}
    url: {{ svc.url | default('') }}
    namespace: {{ svc.namespace | default('') }}
    username: {{ svc.username | default('') }}
    password: >-
      {% if mode == 'summary' %}{{ svc.password_masked | default('') }}{% else %}{{ svc.password | default('') }}{% endif %}
    auth: {{ svc.auth | default('') }}
    password_format: {{ svc.password_format | default('plain') }}
{% endfor %}

dns_secrets:
{% for entry in report.dns_secrets | default([]) %}
  - id: {{ entry.id }}
    title: {{ entry.title }}
    password_key: {{ entry.password_key }}
    value: >-
      {% if mode == 'summary' %}{{ entry.value_masked | default('') }}{% else %}{{ entry.value | default('') }}{% endif %}
{% endfor %}

oauth_secrets:
{% for entry in report.oauth_secrets | default([]) %}
  - id: {{ entry.id }}
    title: {{ entry.title }}
    password_key: {{ entry.password_key }}
    value: >-
      {% if mode == 'summary' %}{{ entry.value_masked | default('') }}{% else %}{{ entry.value | default('') }}{% endif %}
{% endfor %}

runtime_secrets:
{% for entry in report.runtime_secrets | default([]) %}
  - id: {{ entry.id }}
    title: {{ entry.title }}
    secret: {{ entry.secret }}
    namespace: {{ entry.namespace }}
    data_key: {{ entry.data_key }}
    value: >-
      {% if mode == 'summary' %}{{ entry.value_masked | default('') }}{% else %}{{ entry.value | default('') }}{% endif %}
{% endfor %}

ingress_apps:
{{ report.ingress_apps | default([]) | to_nice_yaml | indent(2, first=True) }}

{% if report.infra | default([]) | length > 0 %}
infra:
{{ report.infra | to_nice_yaml | indent(2, first=True) }}
{% endif %}

users:
{{ report.users | default({}) | to_nice_yaml | indent(2, first=True) }}

secrets:
{% if mode == 'summary' %}
{% for key, value in report.secrets | default({}) | dictsort %}
  {{ key }}: >-
    {% if value | length > 4 %}{{ value[:2] }}{{ '*' * (value | length - 4) }}{{ value[-2:] }}{% else %}{{ value }}{% endif %}
{% endfor %}
{% else %}
{{ report.secrets | default({}) | to_nice_yaml | indent(2, first=True) }}
{% endif %}
