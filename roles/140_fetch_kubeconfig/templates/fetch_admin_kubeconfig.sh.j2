#!/usr/bin/env bash
# Fetch cluster admin kubeconfig from the first control-plane node via SSH.
# Rendered by 29_fetch_kubeconfig; runs on the Ansible controller only.
set -euo pipefail

readonly REMOTE_PATH={{ k8s_fetch_kubeconfig_remote_path | quote }}
readonly DEST_PATH={{ controller_kubeconfig | quote }}
readonly SSH_TARGET={{ k8s_fetch_kubeconfig_ssh_target | quote }}
readonly TMP_PATH="${DEST_PATH}.tmp.$$"

cleanup() {
  rm -f "${TMP_PATH}"
}
trap cleanup EXIT

ssh_cmd=(
  ssh
  -o BatchMode=yes
  -o ConnectTimeout=30
  -o StrictHostKeyChecking=no
  -o UserKnownHostsFile=/dev/null
{% if k8s_fetch_kubeconfig_ssh_private_key_file | length > 0 %}
  -i {{ k8s_fetch_kubeconfig_ssh_private_key_file | quote }}
{% endif %}
{% for ssh_arg in k8s_fetch_kubeconfig_ssh_extra_args | default([]) %}
  {{ ssh_arg | quote }}
{% endfor %}
  "${SSH_TARGET}"
  sudo
  cat
  "${REMOTE_PATH}"
)

if ! "${ssh_cmd[@]}" > "${TMP_PATH}"; then
  echo "29_fetch_kubeconfig: failed to read ${REMOTE_PATH} from ${SSH_TARGET}" >&2
  exit 1
fi

if [[ ! -s "${TMP_PATH}" ]]; then
  echo "29_fetch_kubeconfig: fetched kubeconfig from ${SSH_TARGET} is empty" >&2
  exit 1
fi

chmod 600 "${TMP_PATH}"
mv -f "${TMP_PATH}" "${DEST_PATH}"
trap - EXIT
