#!/bin/bash
set -euo pipefail

export KUBECONFIG="{{ k8s_kubeconfig }}"

NAMESPACE="{{ vault_namespace }}"
INIT_POD="vault-0"
PODS=({% for i in range(vault_ha_replicas | default(3) | int) %}"vault-{{ i }}"{% if not loop.last %} {% endif %}{% endfor %})
KEYS_FILE="{{ k8s_manifests_dir }}/vault-init-keys.txt"
LEGACY_KEYS_FILE="{{ k8s_manifests_dir }}/output_file.txt"

{% raw %}
vault_status() {
  local pod="$1"
  local output
  local rc

  set +e
  output=$(kubectl exec -n "$NAMESPACE" "$pod" -- vault status -format=json 2>/dev/null)
  rc=$?
  set -e

  # vault status: 0=unsealed, 1=error, 2=sealed (still returns JSON)
  if [[ "$rc" -ne 0 && "$rc" -ne 2 ]]; then
    echo "$output" >&2
    return 1
  fi

  echo "$output"
}

status_field() {
  local pod="$1"
  local field="$2"
  vault_status "$pod" | jq -r --arg f "$field" '.[$f]'
}

wait_for_vault_api() {
  local pod="$1"
  local attempt

  for attempt in $(seq 1 120); do
    if vault_status "$pod" >/dev/null; then
      return 0
    fi
    sleep 5
  done

  echo "ERROR: Vault API on $pod is not responding" >&2
  return 1
}

load_unseal_keys() {
  mapfile -t UNSEAL_KEYS < <(grep -E '^Unseal Key [0-9]+:' "$KEYS_FILE" | awk '{print $NF}')

  if [[ "${#UNSEAL_KEYS[@]}" -lt 1 ]]; then
    echo "ERROR: No unseal keys found in $KEYS_FILE" >&2
    exit 1
  fi
}

unseal_pod_if_needed() {
  local pod="$1"
  local threshold
  local sealed
  local progress
  local key_index

  wait_for_vault_api "$pod"

  sealed="$(status_field "$pod" sealed)"
  if [[ "$sealed" != "true" ]]; then
    echo "Vault on $pod is already unsealed; skipping"
    return 0
  fi

  threshold="$(status_field "$pod" t)"
  if [[ -z "$threshold" || "$threshold" == "null" || "$threshold" -lt 1 ]]; then
    threshold=3
  fi

  if [[ "${#UNSEAL_KEYS[@]}" -lt "$threshold" ]]; then
    echo "ERROR: Need $threshold unseal keys, found ${#UNSEAL_KEYS[@]} in $KEYS_FILE" >&2
    exit 1
  fi

  echo "Unsealing $pod (threshold=$threshold)"
  for ((key_index = 0; key_index < threshold; key_index++)); do
    kubectl exec -n "$NAMESPACE" "$pod" -- vault operator unseal "${UNSEAL_KEYS[$key_index]}" >/dev/null
    sealed="$(status_field "$pod" sealed)"
    progress="$(status_field "$pod" progress)"
    echo "  $pod: unseal progress ${progress}, sealed=${sealed}"
    if [[ "$sealed" != "true" ]]; then
      echo "Vault unsealed on $pod"
      return 0
    fi
  done

  if [[ "$(status_field "$pod" sealed)" == "true" ]]; then
    echo "ERROR: Failed to unseal $pod" >&2
    exit 1
  fi
}

if [[ ! -s "$KEYS_FILE" && -s "$LEGACY_KEYS_FILE" ]]; then
  cp "$LEGACY_KEYS_FILE" "$KEYS_FILE"
  chmod 600 "$KEYS_FILE"
  echo "Migrated legacy keys from $LEGACY_KEYS_FILE to $KEYS_FILE"
fi

wait_for_vault_api "$INIT_POD"

initialized="$(status_field "$INIT_POD" initialized)"
if [[ "$initialized" != "true" ]]; then
  echo "Initializing Vault on $INIT_POD"
  kubectl exec -n "$NAMESPACE" "$INIT_POD" -- vault operator init > "$KEYS_FILE"
  chmod 600 "$KEYS_FILE"
  echo "Vault init output saved to $KEYS_FILE"
else
  echo "Vault already initialized"
  if [[ ! -s "$KEYS_FILE" ]]; then
    echo "ERROR: Vault is initialized but keys file $KEYS_FILE is missing." >&2
    echo "Restore unseal keys into that file (format: 'Unseal Key N: <key>') or recover from backup." >&2
    exit 1
  fi
fi

load_unseal_keys

for pod in "${PODS[@]}"; do
  unseal_pod_if_needed "$pod"
done

echo "Vault init/unseal completed successfully."
{% endraw %}
